# Copy to .env. Never commit credentials.
# fixture = deterministic guided example, explicitly labeled in the UI.
# anthropic = live Strands agent with ANTHROPIC_API_KEY.
# bedrock = live Strands agent with the AWS SDK credential chain.
AGENT_PROVIDER=fixture
AGENT_MODEL_ID=
ANTHROPIC_API_KEY=
AWS_REGION=us-east-1
SERVICESIGNAL_DB=data/servicesignal.sqlite
PUBLISHER_ORIGIN=http://127.0.0.1:8017
PUBLIC_ORIGIN=http://localhost:8017
# Set COOKIE_SECURE=1 behind HTTPS. Demo sessions expire after seven days.
COOKIE_SECURE=0
# Maximum live interpretation calls per workspace and globally per UTC day.
WORKSPACE_MODEL_LIMIT=20
DAILY_MODEL_LIMIT=100
