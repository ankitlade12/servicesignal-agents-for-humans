# Copy to .env. Never commit credentials.
# fixture = deterministic guided example, explicitly labeled in the UI.
# openai = live Strands agent with OPENAI_API_KEY.
# anthropic = live Strands agent with ANTHROPIC_API_KEY.
# bedrock = live Strands agent with the AWS SDK credential chain.
# demo = anonymous fictional workspaces; pilot = persistent organization accounts.
SERVICESIGNAL_MODE=demo
AGENT_PROVIDER=fixture
AGENT_MODEL_ID=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AWS_REGION=us-east-1
SERVICESIGNAL_DB=data/servicesignal.sqlite
PUBLISHER_ORIGIN=http://127.0.0.1:8017
PUBLIC_ORIGIN=http://localhost:8017
# Set COOKIE_SECURE=1 behind HTTPS. Demo sessions expire after seven days.
COOKIE_SECURE=0
# Maximum live interpretation calls per workspace and globally per UTC day.
WORKSPACE_MODEL_LIMIT=20
DAILY_MODEL_LIMIT=100

# Optional features. Configure secrets on the hosting platform, not in source control.
PDF_OCR_ENABLED=1
# Keep the encryption key stable across deployments and restore operations.
# If omitted, a restricted key file is created next to SERVICESIGNAL_DB.
SERVICESIGNAL_ENCRYPTION_KEY=
BACKUP_DIRECTORY=data/backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_COUNT=7
# Zero disables automatic private-source deletion.
SOURCE_RETENTION_DAYS=0
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PREFIX=servicesignal/
OPERATOR_METRICS_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Operator-managed JSON file; each connector is bound to an organization and program.
SERVICESIGNAL_CONNECTORS_FILE=
